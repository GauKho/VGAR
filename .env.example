# Copy to .env (git-ignored). Real environment variables override this file.

# --- Model ---------------------------------------------------------------
VGAR_MODEL_PROVIDER=huggingface
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
HF_TOKEN=hf_your_token_here
VGAR_TEMPERATURE=0
MAX_NEW_TOKENS=512
VGAR_DEVICE_MAP=auto
VGAR_TORCH_DTYPE=auto

# --- Agent ---------------------------------------------------------------
MAX_ITERATIONS=5
VGAR_MAX_TOOL_CALLS=30
VGAR_RECURSION_LIMIT=50
VGAR_TOKEN_BUDGET=8000

# --- Graph backend (demo | sqlite) ----------------------------------------
VGAR_GRAPH_BACKEND=demo
# Required when VGAR_GRAPH_BACKEND=sqlite (relative paths resolve from project root)
VGAR_GRAPH_DATABASE=artifacts/sample_graph.db
# Optional: pin one snapshot; empty = latest ready
VGAR_GRAPH_VERSION=
VGAR_MCP_AUDIT_LOG=logs/mcp_audit.jsonl

# Host-managed capability; keep blank here. CLI/workflow binds each disposable lease.
# Unbound repository/execution servers allow discovery/health, deny read/write/tests.
VGAR_WORKSPACE_ROOT=

# W6 read-only graph source binding; task context is persisted by task_handle.
VGAR_GRAPH_SOURCE_ROOT=
VGAR_TOKENIZER_MANIFEST=
# Diagnostic fixtures ONLY. Keep 0 for official paired retrieval evaluation.
VGAR_ALLOW_FALLBACK_COUNTER=0
