{
  "mcpServers": {
    "vgar-graph": {
      "command": "<ABSOLUTE PATH TO>/vgar_mcp_mvp_demo/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "vgar.mcp.servers.graph_server"
      ],
      "env": {
        "VGAR_GRAPH_BACKEND": "sqlite",
        "VGAR_GRAPH_DATABASE": "<ABSOLUTE PATH TO>/graphs/<repo>.db",
        "VGAR_REPOSITORY_ROOT": "<ABSOLUTE PATH TO THE REPOSITORY>",
        "VGAR_MCP_LOG_LEVEL": "WARNING",
        "PYTHONUTF8": "1",
        "VGAR_MCP_AUDIT_LOG": "<ABSOLUTE PATH TO>/vgar-logs/graph.jsonl"
      }
    },
    "vgar-execution": {
      "command": "<ABSOLUTE PATH TO>/vgar_mcp_mvp_demo/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "vgar.mcp.servers.execution_server"
      ],
      "env": {
        "VGAR_GRAPH_BACKEND": "sqlite",
        "VGAR_GRAPH_DATABASE": "<ABSOLUTE PATH TO>/graphs/<repo>.db",
        "VGAR_REPOSITORY_ROOT": "<ABSOLUTE PATH TO THE REPOSITORY>",
        "VGAR_MCP_LOG_LEVEL": "WARNING",
        "PYTHONUTF8": "1",
        "VGAR_MCP_AUDIT_LOG": "<ABSOLUTE PATH TO>/vgar-logs/execution.jsonl"
      }
    },
    "vgar-repository": {
      "command": "<ABSOLUTE PATH TO>/vgar_mcp_mvp_demo/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "vgar.mcp.servers.repository_server"
      ],
      "env": {
        "VGAR_LEASE_ROOT": "<ABSOLUTE PATH TO THE REPOSITORY>",
        "PYTHONUTF8": "1",
        "VGAR_MCP_AUDIT_LOG": "<ABSOLUTE PATH TO>/vgar-logs/repository.jsonl"
      }
    }
  }
}
