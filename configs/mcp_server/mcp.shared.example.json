{
  "mcpServers": {
    "vgar-graph": {
      "type": "stdio",
      "command": "<ABSOLUTE PATH TO>/vgar_mcp_mvp_demo/.venv/Scripts/python.exe",
      "args": ["-m", "vgar.mcp.servers.graph_server"],
      "env": {"PYTHONUTF8": "1", "VGAR_MCP_LOG_LEVEL": "WARNING"}
    },
    "vgar-execution": {
      "type": "stdio",
      "command": "<ABSOLUTE PATH TO>/vgar_mcp_mvp_demo/.venv/Scripts/python.exe",
      "args": ["-m", "vgar.mcp.servers.execution_server"],
      "env": {"PYTHONUTF8": "1", "VGAR_MCP_LOG_LEVEL": "WARNING"}
    },
    "vgar-repository": {
      "type": "stdio",
      "command": "<ABSOLUTE PATH TO>/vgar_mcp_mvp_demo/.venv/Scripts/python.exe",
      "args": ["-m", "vgar.mcp.servers.repository_server"],
      "env": {"PYTHONUTF8": "1"}
    }
  }
}
