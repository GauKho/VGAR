+_PROSE_TOKEN_TYPES = frozenset({tokenize.STRING, tokenize.COMMENT} | {
+    getattr(tokenize, name) for name in ("FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END") if hasattr(tokenize, name)})
+
+
+def _explicit_code_spans(text: str) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    """Spans that make a symbol explicit, and the spans inside them that do not (D5, W11).
+
+    Inline code counts. A fenced block counts only if it parses as Python (R2: logs, shell output and
+    tracebacks are not code), and its string literals and comments do not (R3).
+    """
+    explicit, excluded = [], []
+    for match in _CODE.finditer(text):
+        fence = match.group("fence")
+        if not fence:
+            explicit.append(match.span())
+            continue
+        body = match.group().split("\n", 1)[1].rsplit(fence, 1)[0]
+        body_start = match.start() + match.group().index("\n") + 1
+        try:
+            ast.parse(body)
+            tokens = list(tokenize.generate_tokens(io.StringIO(body).readline))
+        except (SyntaxError, ValueError, RecursionError, tokenize.TokenError):
+            continue
+        explicit.append(match.span())
+        starts = [body_start]
+        for line in io.StringIO(body).readlines():
+            starts.append(starts[-1] + len(line))
+        for token in tokens:
+            if token.type in _PROSE_TOKEN_TYPES:
+                excluded.append((starts[token.start[0] - 1] + token.start[1], starts[token.end[0] - 1] + token.end[1]))
+    return explicit, excluded
+
+
+def _starts_sentence(text: str, position: int) -> bool:
+    prefix = text[:position].rstrip(" \t")
+    return not prefix or prefix[-1] in ".!?\n"
+
