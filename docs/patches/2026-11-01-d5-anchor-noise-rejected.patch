+    @staticmethod
+    def _scores(source: str, issue: str) -> dict[str, float]:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "app.py").write_text(source, encoding="utf-8")
+            finder = TaskAnchorFinder(PythonGraphBuilder(repo_key="demo/d5", repository_revision="fixture").build(root))
+        return {anchor.symbol: anchor.score for anchor in finder.find_task_anchors(issue).anchors}
+
+    def test_sentence_initial_capitalised_word_is_not_code_like(self) -> None:
+        # D5 R1 (pylint-6386 "Similar behaviour ..."): a capital only because it starts a sentence is prose.
+        source = "def When(): pass\n"
+        self.assertLessEqual(self._scores(source, "When the option is set, the checker crashes.")["app.When"], 0.4)
+        self.assertEqual(self._scores(source, "The checker crashes in When.")["app.When"], 0.6)
+
+    def test_real_class_at_sentence_start_is_still_anchored(self) -> None:
+        # D5c (Review Focus 5): demoted, never dropped.
+        self.assertGreater(self._scores("class Session: pass\n", "Session objects leak connections.")["app.Session"], 0)
+
+    def test_tokens_in_unparseable_fence_are_not_explicit(self) -> None:
+        # D5 R2 (pylint-4604 "Module a", pylint-6386 "usage: pylint"): log output is not code.
+        issue = "Crash\n```\n************* Module x\nChecker failed: see log\n```"
+        self.assertLess(self._scores("class Checker: pass\n", issue)["app.Checker"], 0.75)
+
+    def test_inline_code_stays_explicit(self) -> None:
+        # D5d
+        self.assertEqual(self._scores("class Checker: pass\n", "`Checker` crashes")["app.Checker"], 0.75)
+
+    def test_tokens_in_strings_and_comments_of_python_fence_are_not_explicit(self) -> None:
+        # D5 R3 (pylint-4604 '"""Docstring."""' and '# type: abc.ABC'): only real code tokens are explicit.
+        source = "class Docstring: pass\ndef mark(): pass\n"
+        issue = '```python\n"""Docstring."""\nimport abc\nX = 1  # mark this\n```'
+        scores = self._scores(source, issue)
+        self.assertLess(scores["app.Docstring"], 0.75)
+        self.assertLess(scores.get("app.mark", 0), 0.75)
+
+    def test_code_tokens_of_python_fence_stay_explicit(self) -> None:
+        self.assertEqual(self._scores("def mark(): pass\n", "```python\ny = mark\n```")["app.mark"], 0.75)
+
