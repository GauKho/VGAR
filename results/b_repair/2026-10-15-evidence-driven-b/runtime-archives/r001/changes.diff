+    allowed_source_paths: tuple[str, ...]
+    protected_paths: tuple[str, ...] = ('tests', 'pytest.ini')
+    trusted_fixture: bool = False
+
+    @field_validator('task_id', 'issue_text', 'repo_key', 'revision', 'graph_version')
